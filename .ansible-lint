---
kinds:
  # Task files included by a playbook, listed before the playbook pattern
  - tasks: "services/proxy/check_published_ports.yml"
  - playbook: "services/*/*.yml"
  - playbook: "dns/*.yml"
  - playbook: "hosts/*/*.yml"
  - playbook: "hosts/*.yml"

exclude_paths:
  - .venv/
  - .ansible/
  - .github/
  - vault/
  - services/website/website/
  - services/*/compose.yml
  - services/proxy/policy.yml
  - services/etat/anneraud.yml
  - services/etat/dera_page.yml
  - services/vigie/grafana/*.yml
  - roles/*/molecule/*/compose.yml
  - roles/*/molecule/*/config.yml
  - roles/*/molecule/*/reloaded_*.yml
  - inventory/
  - requirements.yml

# ansible-lint does not follow module_defaults, which sets zone in the Cloudflare playbooks
warn_list:
  - args[module]
