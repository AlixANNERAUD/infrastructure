# Configuration file for Synapse.
#
# This is a YAML file: see [1] for a quick introduction. Note in particular
# that *indentation is important*: all the elements of a list or dictionary
# should have the same indentation.
#
# [1] https://docs.ansible.com/ansible/latest/reference_appendices/YAMLSyntax.html
#
# For more information on how to configure Synapse, including a complete accounting of
# each option, go to docs/usage/configuration/config_documentation.md or
# https://element-hq.github.io/synapse/latest/usage/configuration/config_documentation.html
server_name: "dera.page"
pid_file: /data/homeserver.pid
listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true
    resources:
      - names: [client, federation]
        compress: false
database:
  name: psycopg2
  txn_limit: 10000
  args:
    user: "{{ database_user }}"
    password: "{{ database_password }}"
    dbname: "{{ database_name }}"
    host: database
    port: 5432
    cp_min: 5
    cp_max: 10
log_config: "/data/dera.page.log.config"
media_store_path: /data/media_store
registration_shared_secret: "{{ registration_shared_secret }}"
report_stats: true
macaroon_secret_key: "{{ macaroon_secret_key }}"
form_secret: "{{ form_secret }}"
signing_key_path: "/data/dera.page.signing.key"
trusted_key_servers:
  - server_name: "matrix.org"
  
enable_registration: True
registration_requires_token: True

# Calls (services/appels, on Luxembourg). Element Call (Element X, group
# calls) finds LiveKit through /_matrix/client/v1/rtc/transports; the type
# livekit with livekit_service_url talks to lk-jwt-service directly (m.livekit
# and url need it registered as an application service)
matrix_rtc:
  transports:
    - type: livekit
      livekit_service_url: https://appels.anneraud.fr/livekit/jwt
# Clients older than the stable endpoint ask the unstable one, then the
# well-known file
experimental_features:
  msc4143_enabled: true
# Element Call's own settings: delayed events end a call left without hanging
# up, and its state updates need more than the default message rate
max_event_delay_duration: 24h
rc_message:
  per_second: 0.5
  burst_count: 30
rc_delayed_event_mgmt:
  per_second: 1
  burst_count: 20
# One-to-one calls go peer to peer, through coturn when NAT gets in the way
turn_uris:
  - "turn:appels.anneraud.fr:3479?transport=udp"
  - "turn:appels.anneraud.fr:3479?transport=tcp"
turn_shared_secret: "{{ turn_shared_secret }}"
turn_user_lifetime: 1h
turn_allow_guests: false
