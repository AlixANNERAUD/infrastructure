# Rendered by services/maison/deploy.yml (Infrastructure repository): changes
# made here are overwritten on the next deploy.
# HTTP settings (port 8080, Traefik's proxy-maison subnet as trusted proxy)
# live in Home Assistant's UI since 2026: Settings > System > Network.

# History and long-term statistics, in the stack's PostgreSQL
recorder:
  purge_keep_days: 30
  commit_interval: 3
  db_url: "postgresql://home-assistant:{{ maison_database_password }}@postgres:5432/home-assistant?sslmode=disable"
{% if zitadel_login_client_id | default('') | length > 0 %}

# Login through Zitadel (OpenID Connect integration, a public client with
# PKCE). Accounts are created at the first login, as users: administrators are
# promoted by hand, Zitadel's roles don't reach Home Assistant's
auth_oidc:
  client_id: "{{ zitadel_login_client_id }}"
  discovery_url: https://authentification.anneraud.fr/.well-known/openid-configuration
  display_name: Zitadel
  # Zitadel's roles are not a list of groups: don't ask for them
  features:
    include_groups_scope: false
    automatic_user_linking: {{ maison_oidc_link_users | bool | lower }}
{% endif %}
