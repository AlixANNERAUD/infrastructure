#jinja2: lstrip_blocks: True
{# Each zone's wildcard certificate (parent domain of a host, or the bare domain itself) is requested by the
   first router that serves it, and only by that one: concurrent orders for the same zone share Let's Encrypt's
   challenge and delete each other's TXT record, so none succeeds. Every other router uses the stored certificate. #}
{% set certificate_requests = namespace(zones=[]) %}
{% macro certificates(hosts, state) %}
{% set requested = namespace(zones=[]) %}
{% for host in hosts %}
{% set labels = host.split('.') %}
{% set zone = host if labels | length == 2 else labels[1:] | join('.') %}
{% if zone not in state.zones and zone not in requested.zones %}
{% set requested.zones = requested.zones + [zone] %}
{% endif %}
{% endfor %}
{% set state.zones = state.zones + requested.zones %}
{% if requested.zones %}
      tls:
        certResolver: letsencrypt
        domains:
{% for zone in requested.zones %}
          - main: {{ zone | to_json }}
            sans:
              - {{ ('*.' ~ zone) | to_json }}
{% endfor %}
{% else %}
      tls: {}
{% endif %}
{% endmacro %}
{% macro host_rule(hosts) %}{{ hosts | map('regex_replace', '^(.*)$', 'Host(`\\1`)') | join(' || ') }}{% endmacro %}
{# Login requests (POST to rate_limit.prefixes, case-insensitive since some apps like Jellyfin ignore case) of a
   route or path go through their own router, which only adds the rate limit: its longer rule takes precedence. #}
{% macro login_router(name, rule, service, internal, cloudflare_only, rate_limit) %}
{% set prefixes = rate_limit.prefixes | map('regex_escape') | map('regex_replace', '^(.*)$', 'PathRegexp(`(?i)^\\1`)') | join(' || ') %}
    {{ (name ~ '-login') | to_json }}:
      rule: {{ ('(' ~ rule ~ ') && Method(`POST`) && (' ~ prefixes ~ ')') | to_json }}
      entryPoints:
        - web-secure
      service: {{ service | to_json }}
      middlewares:
{% if internal %}
        - internal-allowlist@file
{% endif %}
{% if cloudflare_only %}
        - cloudflare-only@file
{% endif %}
        - {{ (name ~ '-login-rate-limit') | to_json }}
      tls: {}
{% endmacro %}
{# Token bucket per client address: average requests per period, after a burst. Behind Cloudflare the client is the
   rightmost X-Forwarded-For address that is not Cloudflare's; an IPv6 client counts as its whole /64. #}
{% macro rate_limit_middleware(name, cloudflare_only, rate_limit) %}
    {{ (name ~ '-login-rate-limit') | to_json }}:
      rateLimit:
        average: {{ rate_limit.average }}
        period: {{ rate_limit.period | to_json }}
        burst: {{ rate_limit.burst }}
        sourceCriterion:
          ipStrategy:
            ipv6Subnet: 64
{% if cloudflare_only %}
            excludedIPs:
{% for network in cloudflare_networks %}
              - {{ network | to_json }}
{% endfor %}
{% endif %}
{% endmacro %}
# Rendered from traefik_routes and traefik_redirects in the host's variables
http:
  routers:
{% for route in traefik_routes %}
    {{ route.name | to_json }}:
    {% if route.prefix is defined %}
      rule: {{ ('(' ~ host_rule(route.hosts) ~ ') && PathPrefix(`' ~ route.prefix ~ '`)') | to_json }}
    {% else %}
      rule: {{ host_rule(route.hosts) | to_json }}
    {% endif %}
      entryPoints:
        - web-secure
      service: {{ route.name | to_json }}
  {% if route.internal or route.cloudflare_only | default(false) %}
      middlewares:
    {% if route.internal %}
        - internal-allowlist@file
    {% endif %}
    {% if route.cloudflare_only | default(false) %}
        - cloudflare-only@file
    {% endif %}
  {% endif %}
{{ certificates(route.hosts, certificate_requests) }}
  {% set route_rule = ('(' ~ host_rule(route.hosts) ~ ') && PathPrefix(`' ~ route.prefix ~ '`)') if route.prefix is defined else host_rule(route.hosts) %}
  {% if route.rate_limit is defined %}
{{ login_router(route.name, route_rule, route.name, route.internal, route.cloudflare_only | default(false), route.rate_limit) }}
  {% endif %}
  {% for path in route.paths | default([]) %}
    {% if path.rate_limit is defined %}
{{ login_router(route.name ~ '-' ~ loop.index, '(' ~ host_rule(route.hosts) ~ ') && PathPrefix(`' ~ path.prefix ~ '`)',
                (route.name ~ '-' ~ loop.index) if path.url is defined else route.name,
                path.internal | default(route.internal), route.cloudflare_only | default(false), path.rate_limit) }}
    {% endif %}
    {{ (route.name ~ '-' ~ loop.index) | to_json }}:
      rule: {{ ('(' ~ host_rule(route.hosts) ~ ') && PathPrefix(`' ~ path.prefix ~ '`)') | to_json }}
      entryPoints:
        - web-secure
    {% if path.redirect is defined %}
      service: noop@internal
    {% else %}
      service: {{ (route.name ~ '-' ~ loop.index) | to_json }}
    {% endif %}
    {% if path.internal | default(route.internal) or route.cloudflare_only | default(false) or path.redirect is defined %}
      middlewares:
      {% if path.internal | default(route.internal) %}
        - internal-allowlist@file
      {% endif %}
      {% if route.cloudflare_only | default(false) %}
        - cloudflare-only@file
      {% endif %}
      {% if path.redirect is defined %}
        - {{ (route.name ~ '-' ~ loop.index ~ '-redirect') | to_json }}
      {% endif %}
    {% endif %}
      tls: {}
  {% endfor %}
{% endfor %}
{% for redirect in traefik_redirects %}
    {{ ('redirect-' ~ redirect.name) | to_json }}:
      rule: {{ host_rule(redirect.hosts) | to_json }}
      entryPoints:
        - web-secure
      service: noop@internal
      middlewares:
  {# Before the redirect, which replies on its own #}
  {% if redirect.cloudflare_only | default(false) %}
        - cloudflare-only@file
  {% endif %}
        - {{ ('redirect-' ~ redirect.name) | to_json }}
{{ certificates(redirect.hosts, certificate_requests) }}
{% endfor %}

  services:
{% for route in traefik_routes %}
    {{ route.name | to_json }}:
      loadBalancer:
        servers:
          - url: {{ route.url | to_json }}
  {% if route.insecure_backend | default(false) %}
        serversTransport: insecure-backend@file
  {% endif %}
  {% for path in route.paths | default([]) %}
    {% if path.url is defined %}
    {{ (route.name ~ '-' ~ loop.index) | to_json }}:
      loadBalancer:
        servers:
          - url: {{ path.url | to_json }}
    {% endif %}
  {% endfor %}
{% endfor %}

  middlewares:
{# Sites proxied by Cloudflare refuse connections that skip it #}
{% set cloudflare_users = (traefik_routes + traefik_redirects) | selectattr('cloudflare_only', 'defined') | selectattr('cloudflare_only') | list %}
{% if cloudflare_users %}
    cloudflare-only:
      ipAllowList:
        sourceRange:
  {% for network in cloudflare_networks %}
          - {{ network | to_json }}
  {% endfor %}
{% endif %}
{% for route in traefik_routes %}
  {% if route.rate_limit is defined %}
{{ rate_limit_middleware(route.name, route.cloudflare_only | default(false), route.rate_limit) }}
  {% endif %}
  {% for path in route.paths | default([]) %}
    {% if path.rate_limit is defined %}
{{ rate_limit_middleware(route.name ~ '-' ~ loop.index, route.cloudflare_only | default(false), path.rate_limit) }}
    {% endif %}
    {% if path.redirect is defined %}
    {{ (route.name ~ '-' ~ loop.index ~ '-redirect') | to_json }}:
      redirectRegex:
        regex: {{ ('^https?://([^/]+)' ~ (path.prefix | regex_escape) ~ '.*') | to_json }}
        replacement: {{ ('https://${1}' ~ path.redirect) | to_json }}
        permanent: true
    {% endif %}
  {% endfor %}
{% endfor %}
{% for redirect in traefik_redirects %}
    {{ ('redirect-' ~ redirect.name) | to_json }}:
      redirectRegex:
        regex: "^https?://[^/]+(.*)"
        replacement: {{ (redirect.to ~ ('${1}' if redirect.preserve_path else '/')) | to_json }}
        permanent: true
{% endfor %}
