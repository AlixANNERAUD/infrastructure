# Configuration file for Synapse.
#
# This is a YAML file: see [1] for a quick introduction. Note in particular
# that *indentation is important*: all the elements of a list or dictionary
# should have the same indentation.
#
# [1] https://docs.ansible.com/ansible/latest/reference_appendices/YAMLSyntax.html
#
# For more information on how to configure Synapse, including a complete accounting of
# each option, go to docs/usage/configuration/config_documentation.md or
# https://element-hq.github.io/synapse/latest/usage/configuration/config_documentation.html
server_name: "anneraud.fr"
# Delegation: Synapse answers anneraud.fr/.well-known/matrix/{server,client}, routed by Traefik on Bruxelles
public_baseurl: "https://matrix.anneraud.fr/"
serve_server_wellknown: true
pid_file: /data/homeserver.pid
listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true
    resources:
      - names: [client, federation]
        compress: false
database:
  name: psycopg2
  txn_limit: 10000
  args:
    user: "{{ database_user }}"
    password: "{{ database_password }}"
    dbname: "{{ database_name }}"
    host: database
    port: 5432
    cp_min: 5
    cp_max: 10
log_config: "/data/anneraud.fr.log.config"
media_store_path: /data/media_store
registration_shared_secret: "{{ registration_shared_secret }}"
report_stats: true
macaroon_secret_key: "{{ macaroon_secret_key }}"
form_secret: "{{ form_secret }}"
signing_key_path: "/data/anneraud.fr.signing.key"
trusted_key_servers:
  - server_name: "matrix.org"
  
enable_registration: True
registration_requires_token: True
{% if matrix_anneraud_oidc_client_id | length > 0 %}

# Login through Zitadel (application matrix in
# opentofu/zitadel/applications.auto.tfvars), next to the password login,
# which stays for existing clients and as the fallback. Without a client, no
# provider: no button that cannot work.
oidc_providers:
  # Logins are linked to "oidc-zitadel": changing idp_id unlinks every account
  - idp_id: zitadel
    idp_name: Zitadel
    issuer: "https://authentification.anneraud.fr"
    client_id: {{ matrix_anneraud_oidc_client_id | to_json }}
    client_secret: {{ matrix_anneraud_oidc_client_secret | to_json }}
    client_auth_method: client_secret_basic
    scopes: [openid, profile]
    # Zitadel leaves the profile (preferred_username) out of the ID token
    user_profile_method: userinfo_endpoint
    # A first login is linked to the existing account whose localpart is the
    # Zitadel username (alix@anneraud.fr → @alix:anneraud.fr), and never
    # creates an account: a login matching none is refused rather than
    # duplicated. Users of other Zitadel organizations get no localpart.
    allow_existing_users: true
    enable_registration: false
    user_mapping_provider:
      config:
        localpart_template: "{% raw %}{{ user.preferred_username | localpart_from_email if user.preferred_username is string and user.preferred_username.endswith('@anneraud.fr') else '' }}{% endraw %}"
{% endif %}
