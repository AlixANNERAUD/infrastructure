# Grafana alerting, rendered by deploy.yml: alert rules on CrowdSec
# (services/protection) and Traefik's login rate limits, in their own group,
# sent to Home Assistant by the policy of alerting.yml. Grafana expands
# environment variables (dollar sign followed by a name) in provisioning files,
# so annotations use .Labels and .Values: no dollar sign here.
# A public address is scanned all day long: the thresholds sit above that
# background, so only what is out of the ordinary reaches the phone.
# CrowdSec's rules only exist when a host runs it (the protection group); Vigie
# scrapes each one as job crowdsec-<host> (scrape.yml.j2).
apiVersion: 1

groups:
  - orgId: 1
    name: Protection
    folder: Vigie
    interval: {{ vigie_alert_evaluation_interval }}
    rules:
{% if groups['protection'] | length > 0 %}
      # up = 0 while CrowdSec is down or out of reach; no up series at all
      # means the scrape job is missing
      - uid: crowdsec-metrics-missing
        title: CrowdSec metrics missing
        condition: threshold
        for: 10m
        noDataState: Alerting
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: up{job=~"crowdsec-.*"}
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: lt, params: [1]}
        annotations:
          summary: "{% raw %}{{ if .Labels.host }}CrowdSec on {{ .Labels.host }} cannot be scraped: the engine is down or out of reach{{ else }}No CrowdSec metrics at all: VictoriaMetrics does not scrape it{{ end }}{% endraw %}"

      # In stream mode Traefik's bouncer asks the local API for new decisions
      # every 15 s. Without these requests (Traefik down, protection network
      # or bouncer key broken) bans are no longer applied: the bouncer lets
      # every request through. Only while CrowdSec itself answers
      - uid: crowdsec-bouncer-silent
        title: CrowdSec bouncer silent
        condition: threshold
        for: 10m
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: >-
                max by (host) (up{job=~"crowdsec-.*"}) == 1
                unless on (host)
                sum by (host) (increase(cs_lapi_bouncer_requests_total[10m])) > 0
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: gt, params: [0]}
        annotations:
          summary: "{% raw %}Traefik's bouncer on {{ .Labels.host }} no longer asks CrowdSec for decisions: bans are not applied{% endraw %}"

      # CrowdSec answers but parses no line of Traefik's access log while
      # Traefik serves requests: the Docker datasource, its socket proxy or the
      # Traefik parser is broken, and nothing gets detected
      - uid: crowdsec-blind
        title: CrowdSec reads no access log
        condition: threshold
        for: 5m
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 1800, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: >-
                (
                  max by (host) (up{job=~"crowdsec-.*"}) == 1
                  unless on (host)
                  sum by (host) (increase(cs_parser_hits_ok_total[30m])) > 0
                )
                and on (host)
                sum by (host) (increase(traefik_entrypoint_requests_total{entrypoint="web-secure"}[30m])) > 0
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: gt, params: [0]}
        annotations:
          summary: "{% raw %}CrowdSec on {{ .Labels.host }} parsed no line of Traefik's access log for 30 minutes: attacks go undetected{% endraw %}"

      # Scenario overflows are the alerts CrowdSec raises, each banning its
      # address for 4 hours. A few per hour are the usual scanners; more
      # means an attack from many addresses at once
      - uid: crowdsec-alert-spike
        title: CrowdSec alert spike
        condition: threshold
        for: 5m
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 3600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: sum by (host) (increase(cs_bucket_overflowed_total[1h]))
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: gt, params: [30]}
        annotations:
          summary: "{% raw %}CrowdSec on {{ .Labels.host }} raised {{ printf \"%.0f\" .Values.query.Value }} alerts in the last hour (see the CrowdSec dashboard){% endraw %}"

{% endif %}
      # Login routers (*-login@file from routes.yml.j2, *-login@docker from
      # labels) answer 429 past their rate limit. Someone who mistypes a
      # password stays far below the threshold; password guessing does not
      - uid: login-rate-limit-spike
        title: Login rate limit spike
        condition: threshold
        for: 1m
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 900, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: sum by (host, router) (increase(traefik_router_requests_total{router=~".+-login@.+", code="429"}[15m]))
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: gt, params: [50]}
        annotations:
          summary: "{% raw %}{{ .Labels.router }} on {{ .Labels.host }} refused {{ printf \"%.0f\" .Values.query.Value }} login requests over its rate limit in 15 minutes{% endraw %}"
