# Grafana alerting, rendered by deploy.yml: Traefik alert rules sent to Home Assistant.
# Grafana expands environment variables (dollar sign followed by a name) in
# provisioning files, so annotations use .Labels and .Values: no dollar sign here
{% set excluded = '(' ~ vigie_latency_excluded_services | join('|') ~ ').*' %}
apiVersion: 1

contactPoints:
  - orgId: 1
    name: Home Assistant
    receivers:
      - uid: home-assistant
        type: webhook
        settings:
          url: https://maison.anneraud.fr/api/webhook/{{ vigie_home_assistant_webhook_id }}
          httpMethod: POST

policies:
  - orgId: 1
    receiver: Home Assistant
    group_by: [alertname, service, host]
    repeat_interval: 4h

groups:
  # Host and container metrics of services/metriques: thresholds held for a
  # while, so that a backup, a scrub or an update does not alert
  - orgId: 1
    name: Hosts
    folder: Vigie
    interval: {{ vigie_alert_evaluation_interval }}
    rules:
      # Filesystems other than ZFS, whose datasets share their pool's space:
      # TrueNAS alerts on pool capacity itself
      - uid: hosts-disk-space-low
        title: Host disk space low
        condition: threshold
        for: 15m
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: >-
                1 - node_filesystem_avail_bytes{fstype!~"zfs|tmpfs|ramfs|squashfs|erofs|iso9660|nfs.*|cifs|fuse.*"}
                / node_filesystem_size_bytes{fstype!~"zfs|tmpfs|ramfs|squashfs|erofs|iso9660|nfs.*|cifs|fuse.*"}
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: gt, params: [0.9]}
        annotations:
          summary: "{% raw %}{{ .Labels.mountpoint }} on {{ .Labels.host }} is {{ humanizePercentage .Values.query.Value }} full{% endraw %}"

      # Pool health from the kernel (DEGRADED, FAULTED, SUSPENDED...): one
      # series per state, 1 for the pool's current one. Pool capacity is left
      # to TrueNAS' own alerts, since node_exporter cannot read it
      - uid: hosts-zfs-pool-unhealthy
        title: ZFS pool unhealthy
        condition: threshold
        for: 5m
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: node_zfs_zpool_state{state!="online"}
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: gt, params: [0]}
        annotations:
          summary: "{% raw %}ZFS pool {{ .Labels.zpool }} on {{ .Labels.host }} is {{ toUpper .Labels.state }}{% endraw %}"

      # Memory the kernel could give to applications, ZFS' ARC included above
      # its minimum: Linux counts the ARC as used, and it fills most of the
      # memory of a TrueNAS server on purpose
      - uid: hosts-memory-high
        title: Host memory high
        condition: threshold
        for: 15m
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: >-
                1 - (
                  (node_memory_MemAvailable_bytes + clamp_min(node_zfs_arc_size - node_zfs_arc_c_min, 0))
                  or node_memory_MemAvailable_bytes
                ) / node_memory_MemTotal_bytes
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: gt, params: [0.9]}
        annotations:
          summary: "{% raw %}{{ .Labels.host }} uses {{ humanizePercentage .Values.query.Value }} of its memory{% endraw %}"

      # Busy share of all CPUs over 5 minutes; waiting for disks (a scrub) and
      # time taken by the hypervisor do not count
      - uid: hosts-cpu-high
        title: Host CPU high
        condition: threshold
        for: 30m
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: >-
                sum by (host) (rate(node_cpu_seconds_total{mode!~"idle|iowait|steal"}[5m]))
                / count by (host) (node_cpu_seconds_total{mode="idle"})
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: gt, params: [0.9]}
        annotations:
          summary: "{% raw %}{{ .Labels.host }} has used {{ humanizePercentage .Values.query.Value }} of its CPU for 30 minutes{% endraw %}"

      # An exporter VictoriaMetrics cannot scrape (up = 0), or no host metrics
      # at all
      - uid: hosts-metrics-missing
        title: Host metrics missing
        condition: threshold
        for: 10m
        noDataState: Alerting
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: up{job=~"(node|containers)-.*"}
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: lt, params: [1]}
        annotations:
          summary: "{% raw %}{{ if .Labels.host }}{{ .Labels.job }} cannot be scraped{{ else }}No host metrics at all: VictoriaMetrics scrapes no exporter{{ end }}{% endraw %}"

      # Every hardware sensor (hwmon): at the drive's own warning threshold
      # (NVMe drives report one), 85 °C for sensors without one (CPUs)
      - uid: hosts-temperature-high
        title: Host temperature high
        condition: threshold
        for: 10m
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: >-
                (
                  (node_hwmon_temp_celsius >= on (host, chip, sensor) (node_hwmon_temp_max_celsius > 0))
                  or (node_hwmon_temp_celsius > 85 unless on (host, chip, sensor) (node_hwmon_temp_max_celsius > 0))
                )
                * on (host, chip) group_left (chip_name) node_hwmon_chip_names
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: gt, params: [0]}
        annotations:
          summary: "{% raw %}{{ .Labels.chip_name }} {{ .Labels.sensor }} on {{ .Labels.host }} is at {{ printf \"%.0f\" .Values.query.Value }} °C{% endraw %}"

      # Time left before a filesystem or a ZFS pool is full at the rate of the
      # last two days (node-mixin's NodeFilesystemSpaceFillingUp, over a week):
      # pools through their root dataset, whose free space is the pool's
      - uid: hosts-disk-filling-up
        title: Host disk filling up
        condition: threshold
        for: 1h
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: >-
                (
                  node_filesystem_avail_bytes{fstype!~"zfs|tmpfs|ramfs|squashfs|erofs|iso9660|nfs.*|cifs|fuse.*"}
                  / (-deriv(node_filesystem_avail_bytes{fstype!~"zfs|tmpfs|ramfs|squashfs|erofs|iso9660|nfs.*|cifs|fuse.*"}[2d]) > 0)
                  and on (host, device, mountpoint) node_filesystem_readonly == 0
                )
                or
                (
                  node_filesystem_avail_bytes{fstype="zfs", device!~".*/.*"}
                  / (-deriv(node_filesystem_avail_bytes{fstype="zfs", device!~".*/.*"}[2d]) > 0)
                )
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: lt, params: [604800]}
        annotations:
          summary: "{% raw %}{{ .Labels.mountpoint }} on {{ .Labels.host }} will be full in {{ humanizeDuration .Values.query.Value }} at the rate of the last two days{% endraw %}"

      # The kernel's OOM killer ended processes: the kernel log names them
      - uid: hosts-oom-kill
        title: Host out of memory
        condition: threshold
        for: 0s
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: increase(node_vmstat_oom_kill[10m])
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: gt, params: [0]}
        annotations:
          summary: "{% raw %}The kernel of {{ .Labels.host }} killed {{ printf \"%.0f\" .Values.query.Value }} process(es) for lack of memory: see dmesg{% endraw %}"

      # node-mixin's NodeClockNotSynchronising: the kernel no longer gets the
      # time from NTP and its error estimate has grown
      - uid: hosts-clock-not-synchronised
        title: Host clock not synchronised
        condition: threshold
        for: 10m
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: node_timex_maxerror_seconds >= 16 and on (host) min_over_time(node_timex_sync_status[5m]) == 0
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: gt, params: [0]}
        annotations:
          summary: "{% raw %}The clock of {{ .Labels.host }} is no longer synchronised (error up to {{ humanizeDuration .Values.query.Value }}): logins and certificates depend on it{% endraw %}"

      # node-mixin's NodeClockSkewDetected: more than 50 ms off, and not
      # converging back
      - uid: hosts-clock-skew
        title: Host clock skew
        condition: threshold
        for: 10m
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: >-
                abs(
                  (node_timex_offset_seconds > 0.05 and deriv(node_timex_offset_seconds[5m]) >= 0)
                  or (node_timex_offset_seconds < -0.05 and deriv(node_timex_offset_seconds[5m]) <= 0)
                )
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: gt, params: [0.05]}
        annotations:
          summary: "{% raw %}The clock of {{ .Labels.host }} is {{ humanizeDuration .Values.query.Value }} off{% endraw %}"

      # A container started 3 times within an hour (cAdvisor's start time):
      # a crash loop; one deploy recreates it once
      - uid: hosts-container-restarting
        title: Container restarting
        condition: threshold
        for: 0s
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: max by (host, app, container) (changes(container_start_time_seconds{container!=""}[1h]))
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: gt, params: [2]}
        annotations:
          summary: "{% raw %}{{ .Labels.container }} on {{ .Labels.host }} started {{ printf \"%.0f\" .Values.query.Value }} times in the last hour{% endraw %}"

  - orgId: 1
    name: Traefik
    folder: Vigie
    interval: {{ vigie_alert_evaluation_interval }}
    rules:
      # Series only exist once a service has answered, so missing data is normal
      - uid: traefik-server-errors
        title: Traefik server errors
        condition: threshold
        for: 10m
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              # Share of 5xx answers over 10 minutes, for services with at least 20 requests
              expr: >-
                (
                  sum by (host, service) (increase(traefik_service_requests_total{code=~"5.."}[10m]))
                  / sum by (host, service) (increase(traefik_service_requests_total[10m]))
                )
                and on (host, service)
                sum by (host, service) (increase(traefik_service_requests_total[10m])) >= 20
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: gt, params: [0.05]}
        annotations:
          summary: "{% raw %}{{ .Labels.service }} on {{ .Labels.host }} answers {{ humanizePercentage .Values.query.Value }} of its requests with a server error{% endraw %}"

      - uid: traefik-slow-responses
        title: Traefik slow responses
        condition: threshold
        for: 15m
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 300, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              # 95th percentile response time over 5 minutes, for services with at least 20 requests,
              # leaving out the services that hold long requests on purpose
              expr: >-
                histogram_quantile(0.95, sum by (host, service, le) (
                  rate(traefik_service_request_duration_seconds_bucket{service!~"{{ excluded }}"}[5m])
                ))
                and on (host, service)
                sum by (host, service) (increase(traefik_service_request_duration_seconds_count{service!~"{{ excluded }}"}[5m])) >= 20
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: gt, params: [2]}
        annotations:
          summary: "{% raw %}{{ .Labels.service }} on {{ .Labels.host }} answers 5 % of its requests in more than {{ humanizeDuration .Values.query.Value }}{% endraw %}"

      # VictoriaMetrics records up = 0 when a Traefik instance cannot be scraped;
      # no up series at all means scraping itself is broken
      - uid: traefik-metrics-missing
        title: Traefik metrics missing
        condition: threshold
        for: 10m
        noDataState: Alerting
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: up{job=~"traefik-.*"}
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: lt, params: [1]}
        annotations:
          summary: "{% raw %}{{ if .Labels.host }}Traefik on {{ .Labels.host }} cannot be scraped{{ else }}No Traefik metrics at all: VictoriaMetrics scrapes nothing{{ end }}{% endraw %}"

  # Certificates both Traefik instances serve, internal names included (Gatus
  # only checks the public endpoints). Let's Encrypt renews them 30 days
  # ahead: one with less than 14 days left failed to renew
  - orgId: 1
    name: Certificates
    folder: Vigie
    interval: {{ vigie_alert_evaluation_interval }}
    rules:
      - uid: certificates-expiring
        title: Certificate expiring
        condition: threshold
        for: 1h
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              # The newest certificate of each name: a renewed one replaces it
              expr: max by (host, cn) (traefik_tls_certs_not_after{cn!="TRAEFIK DEFAULT CERT"}) - time()
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: lt, params: [1209600]}
        annotations:
          summary: "{% raw %}The certificate of {{ .Labels.cn }} on {{ .Labels.host }} expires in {{ humanizeDuration .Values.query.Value }}: its renewal failed{% endraw %}"
{% if groups['sauvegarde'] | default([]) | length > 0 %}

  # Backup to Google Drive (services/sauvegarde): its script writes its result
  # for node_exporter's textfile collector after each run. Without any result
  # yet (before the first run ends, the first upload takes days) nothing fires
  - orgId: 1
    name: Backups
    folder: Vigie
    interval: {{ vigie_alert_evaluation_interval }}
    rules:
      - uid: backups-failed
        title: Backup failed
        condition: threshold
        for: 0s
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: sauvegarde_last_run_success
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: lt, params: [1]}
        annotations:
          summary: "{% raw %}The last backup of {{ .Labels.host }} to Google Drive failed: see logs/ in its Sauvegarde folder{% endraw %}"

      # A day and a half: one missed night, whatever the reason (failed runs,
      # no run at all, a run that never ends)
      - uid: backups-stale
        title: Backup stale
        condition: threshold
        for: 0s
        noDataState: OK
        execErrState: Error
        data:
          - refId: query
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              refId: query
              instant: true
              range: false
              expr: time() - sauvegarde_last_success_timestamp_seconds
          - refId: threshold
            datasourceUid: __expr__
            model:
              refId: threshold
              type: threshold
              expression: query
              conditions:
                - evaluator: {type: gt, params: [129600]}
        annotations:
          summary: "{% raw %}The last successful backup of {{ .Labels.host }} to Google Drive is {{ humanizeDuration .Values.query.Value }} old{% endraw %}"
{% endif %}
