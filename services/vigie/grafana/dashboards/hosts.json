    {
      "type": "bargauge",
      "title": "ZFS pools free space",
      "description": "Space left in each pool, as its datasets see it (TrueNAS alerts on pool capacity)",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max by (host, pool) (label_replace(node_filesystem_avail_bytes{host=~\"$host\", fstype=\"zfs\"}, \"pool\", \"$1\", \"device\", \"([^/]+).*\"))",
          "legendFormat": "{{host}} {{pool}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      }
    },
