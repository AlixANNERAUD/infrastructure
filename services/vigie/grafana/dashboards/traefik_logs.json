  },
  "description": "Traefik's access log of both hosts (VictoriaLogs), filtered by host, client address, domain and status",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "protection"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Traefik logs",
  "uid": "traefik-logs",
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "host",
        "description": "luxembourg or bruxelles; * for both",
        "type": "textbox",
        "query": "*",
        "current": {
          "text": "*",
          "value": "*"
        },
        "options": [
          {
            "selected": true,
            "text": "*",
            "value": "*"
          }
        ],
        "hide": 0
      },
      {
        "name": "client",
        "label": "client address",
        "description": "ClientHost, for instance 34.38.220.175; * for any",
        "type": "textbox",
        "query": "*",
        "current": {
          "text": "*",
          "value": "*"
        },
        "options": [
          {
            "selected": true,
            "text": "*",
            "value": "*"
          }
        ],
        "hide": 0
      },
      {
        "name": "domain",
        "label": "domain",
        "description": "RequestHost, for instance simrepo.dera.page; * for any",
        "type": "textbox",
        "query": "*",
        "current": {
          "text": "*",
          "value": "*"
        },
        "options": [
          {
            "selected": true,
            "text": "*",
            "value": "*"
          }
        ],
        "hide": 0
      },
      {
        "name": "status",
        "label": "status",
        "description": "DownstreamStatus, for instance 404; * for any",
        "type": "textbox",
        "query": "*",
        "current": {
          "text": "*",
          "value": "*"
        },
        "options": [
          {
            "selected": true,
            "text": "*",
            "value": "*"
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests by status",
      "description": "Access log lines per HTTP status",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "{container_name=\"traefik\"} host:$host ClientHost:$client RequestHost:$domain DownstreamStatus:$status | stats by (DownstreamStatus) count() requests",
          "queryType": "statsRange",
          "legendFormat": "{{DownstreamStatus}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Top clients",
      "description": "Client addresses with the most requests",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "{container_name=\"traefik\"} host:$host ClientHost:$client RequestHost:$domain DownstreamStatus:$status | stats by (ClientHost) count() requests | sort by (requests desc) | limit 20",
          "queryType": "stats"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ],
            "labelsToFields": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Field": true
            },
            "renameByName": {
              "Last *": "Requests"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Errors by domain",
      "description": "Answers with a status of 400 or more, per domain and status",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "{container_name=\"traefik\"} host:$host ClientHost:$client RequestHost:$domain DownstreamStatus:$status DownstreamStatus:>=400 | stats by (RequestHost, DownstreamStatus) count() requests | sort by (requests desc) | limit 20",
          "queryType": "stats"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ],
            "labelsToFields": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Field": true
            },
            "renameByName": {
              "Last *": "Requests"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top paths",
      "description": "Most requested paths, with their status and answer size: a probe answered with the home page has the home page's size",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "{container_name=\"traefik\"} host:$host ClientHost:$client RequestHost:$domain DownstreamStatus:$status | stats by (RequestHost, RequestPath, DownstreamStatus, DownstreamContentSize) count() requests | sort by (requests desc) | limit 30",
          "queryType": "stats"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ],
            "labelsToFields": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Field": true
            },
            "renameByName": {
              "Last *": "Requests"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Requests",
      "description": "The matching requests, newest first; expand a line for all of Traefik's fields (router, service, user agent, duration)",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "{container_name=\"traefik\"} host:$host ClientHost:$client RequestHost:$domain DownstreamStatus:$status",
          "queryType": "instant",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
