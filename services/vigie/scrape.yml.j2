# VictoriaMetrics scrape configuration, rendered by deploy.yml
global:
  scrape_interval: 30s

scrape_configs:
  # Luxembourg's Traefik, on its internal metrics entrypoint in the traefik-metrics network
  - job_name: traefik-luxembourg
    metrics_path: /metrics
    scheme: http
    static_configs:
      - targets: ["traefik:8082"]
        labels:
          host: luxembourg

  # Bruxelles' Traefik over Netbird, behind its internal allowlist
  - job_name: traefik-bruxelles
    metrics_path: /metrics
    scheme: https
    static_configs:
      - targets: ["{{ hostvars['bruxelles'].traefik_dashboard_host }}"]
        labels:
          host: bruxelles
{% for group, alias, page in vigie_gatus_instances if inventory_hostname in groups[group] | default([]) %}

  # Gatus of {{ page }} (services/etat), by its alias in the proxy network
  - job_name: {{ alias }}
    metrics_path: /metrics
    scheme: http
    static_configs:
      - targets: ["{{ alias }}:8080"]
        labels:
          page: {{ page }}
{% endfor %}
{% for host in groups['protection'] | sort %}
{%   set local = host == inventory_hostname %}

  # CrowdSec on {{ host }} (services/protection): {{ 'over the internal protection-metrics network' if local else "through the host's Traefik (metriques_host), behind its internal allowlist" }}
  - job_name: crowdsec-{{ host }}
    metrics_path: {{ '/metrics' if local else '/crowdsec/metrics' }}
    scheme: {{ 'http' if local else 'https' }}
    static_configs:
      - targets: ["{{ 'crowdsec:6060' if local else hostvars[host].metriques_host }}"]
        labels:
          host: {{ host }}
{% endfor %}

  # Host and container metrics of every host of the metriques group
  # (services/metriques): inside the metriques network on Vigie's own host,
  # through the host's Traefik (metriques_host) elsewhere
{% for host in groups['metriques'] | sort %}
{%   set routed = hostvars[host].metriques_host is defined %}
  - job_name: node-{{ host }}
    metrics_path: {{ '/node/metrics' if routed else '/metrics' }}
    scheme: {{ 'https' if routed else 'http' }}
    static_configs:
      - targets: ["{{ hostvars[host].metriques_host if routed else 'node-exporter:9100' }}"]
        labels:
          host: {{ host }}

  - job_name: containers-{{ host }}
    metrics_path: {{ '/containers/metrics' if routed else '/metrics' }}
    scheme: {{ 'https' if routed else 'http' }}
    static_configs:
      - targets: ["{{ hostvars[host].metriques_host if routed else 'cadvisor:8080' }}"]
        labels:
          host: {{ host }}
    metric_relabel_configs:
      # Only what the Hosts dashboard and alerts read
      - source_labels: [__name__]
        regex: container_(cpu_usage_seconds_total|memory_working_set_bytes|memory_rss|spec_memory_limit_bytes|network_(receive|transmit)_bytes_total|fs_(reads|writes)_bytes_total|start_time_seconds)|machine_(cpu_cores|memory_bytes)
        action: keep
      # scope="host": the root container, whose network is the host's
      - source_labels: [id]
        regex: /
        target_label: scope
        replacement: host
      # app: the Compose project without TrueNAS' ix- prefix, or the container
      # name for containers started outside Compose
      - source_labels: [name]
        target_label: container
      - source_labels: [name]
        target_label: app
      - source_labels: [container_label_com_docker_compose_project]
        regex: (?:ix-)?(.+)
        target_label: app
      - regex: id|name|container_label_.*
        action: labeldrop

{% endfor %}
